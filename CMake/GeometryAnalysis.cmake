# Portable geometric support shared by surface fields and domain-specific analysis.
get_filename_component(_je_geometry_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(JEGeometryAnalysis STATIC "${_je_geometry_root}/Source/GeometryAnalysis.cpp")
add_library(JE::GeometryAnalysis ALIAS JEGeometryAnalysis)
target_include_directories(JEGeometryAnalysis PUBLIC "${_je_geometry_root}/Source")
target_compile_features(JEGeometryAnalysis PUBLIC cxx_std_20)
add_executable(GeometryAnalysisTests "${_je_geometry_root}/Tests/GeometryAnalysisTests.cpp")
target_link_libraries(GeometryAnalysisTests PRIVATE JEGeometryAnalysis)
if(MSVC)
    target_compile_options(JEGeometryAnalysis PRIVATE /W4 /utf-8 /EHsc)
    target_compile_options(GeometryAnalysisTests PRIVATE /W4 /utf-8 /EHsc)
endif()
add_test(NAME Playground.GeometryAnalysis COMMAND GeometryAnalysisTests)
unset(_je_geometry_root)
