# Portable authoring core and Playground adapters. O3DE can consume the core alone.
add_library(JEAnimationToolsCore STATIC
    "${PLAYGROUND_ROOT}/Source/AnimationCore.cpp"
    "${PLAYGROUND_ROOT}/Source/AnimationInteraction.cpp")
add_library(JE::AnimationTools ALIAS JEAnimationToolsCore)
add_library(JEAnimationInteraction ALIAS JEAnimationToolsCore)
add_executable(AnimationInteractionTests "${PLAYGROUND_ROOT}/Tests/AnimationInteractionTests.cpp")
target_link_libraries(AnimationInteractionTests PRIVATE JEAnimationInteraction)
add_test(NAME Playground.AnimationInteraction COMMAND AnimationInteractionTests)
set_tests_properties(Playground.AnimationInteraction PROPERTIES WORKING_DIRECTORY "${PLAYGROUND_ROOT}")
target_compile_features(JEAnimationToolsCore PUBLIC cxx_std_20)
target_include_directories(JEAnimationToolsCore PUBLIC "${PLAYGROUND_ROOT}/Source")
if(TARGET ExperimentRecipe)
    set(animation_model_target ExperimentRecipe)
    set(animation_application_target JericoGeologyPlaygroundRecovered)
    target_include_directories(JEAnimationToolsCore PRIVATE "${RECOVERY_DEPS}/json")
else()
    set(animation_model_target PlaygroundModel)
    set(animation_application_target JericoGeologyPlayground)
    target_include_directories(JEAnimationToolsCore PRIVATE "${JERICO_DEPS}/DiligentTools/ThirdParty/json/single_include")
endif()
enable_language(C)
add_library(AnimationFbx STATIC "${PLAYGROUND_ROOT}/External/AnimationImport/ufbx.c")
target_include_directories(AnimationFbx PUBLIC "${PLAYGROUND_ROOT}/External/AnimationImport")
add_library(PlaygroundAnimationImport STATIC "${PLAYGROUND_ROOT}/Source/AnimationImport.cpp"
    "${PLAYGROUND_ROOT}/Source/AnimationRigFit.cpp" "${PLAYGROUND_ROOT}/Source/AnimationMouthFit.cpp"
    "${PLAYGROUND_ROOT}/Source/AnimationMeshAnalysis.cpp")
if(TARGET ExperimentRecipe)
    target_include_directories(PlaygroundAnimationImport PRIVATE "${RECOVERY_DEPS}/json" "${RECOVERY_DEPS}/stb"
        "${ENGINE_INPUTS}/Tools/ProceduralAuthoring/Source")
else()
    target_include_directories(PlaygroundAnimationImport PRIVATE "${JERICO_DEPS}/_deps/stb-src"
        "${JERICO_SOURCE}/Tools/ProceduralAuthoring/Source")
endif()
target_link_libraries(PlaygroundAnimationImport PUBLIC JEAnimationToolsCore ${animation_model_target} PRIVATE AnimationFbx JEGeometryAnalysis)
if(TARGET JEGeometryArchetypes)
    target_link_libraries(PlaygroundAnimationImport PRIVATE JEGeometryArchetypes)
endif()
target_sources(${animation_application_target} PRIVATE "${PLAYGROUND_ROOT}/Source/AnimationLabUI.cpp")
target_link_libraries(${animation_application_target} PRIVATE PlaygroundAnimationImport)
add_library(PlaygroundAnimationPhysics STATIC "${PLAYGROUND_ROOT}/Source/AnimationInteractionPhysics.cpp")
target_link_libraries(PlaygroundAnimationPhysics PUBLIC JEAnimationInteraction)
if(TARGET ExperimentPhysics)
    target_link_libraries(PlaygroundAnimationPhysics PRIVATE ExperimentPhysics Jolt)
else()
    target_link_libraries(PlaygroundAnimationPhysics PRIVATE PlaygroundWebPhysics)
    target_include_directories(PlaygroundAnimationPhysics PRIVATE "${JERICO_DEPS}/_deps/jolt-src")
    target_compile_definitions(PlaygroundAnimationPhysics PRIVATE JPH_CROSS_PLATFORM_DETERMINISTIC)
endif()
target_link_libraries(${animation_application_target} PRIVATE PlaygroundAnimationPhysics)
add_library(PlaygroundGeometryContacts STATIC "${PLAYGROUND_ROOT}/Source/GeometryContacts.cpp")
target_link_libraries(PlaygroundGeometryContacts PUBLIC JEGeometryAnalysis)
if(TARGET ExperimentPhysics)
    target_link_libraries(PlaygroundGeometryContacts PRIVATE ExperimentPhysics Jolt)
else()
    target_link_libraries(PlaygroundGeometryContacts PRIVATE PlaygroundWebPhysics)
    target_include_directories(PlaygroundGeometryContacts PRIVATE "${JERICO_DEPS}/_deps/jolt-src")
    target_compile_definitions(PlaygroundGeometryContacts PRIVATE JPH_CROSS_PLATFORM_DETERMINISTIC)
endif()
target_link_libraries(PlaygroundAnimationImport PRIVATE PlaygroundGeometryContacts)
add_executable(AnimationInteractionPhysicsTests "${PLAYGROUND_ROOT}/Tests/AnimationInteractionPhysicsTests.cpp")
target_link_libraries(AnimationInteractionPhysicsTests PRIVATE PlaygroundAnimationPhysics)
add_test(NAME Playground.AnimationInteractionPhysics COMMAND AnimationInteractionPhysicsTests)
set_tests_properties(Playground.AnimationInteractionPhysics PROPERTIES WORKING_DIRECTORY "${PLAYGROUND_ROOT}")
add_executable(AnimationAnatomyContactTests "${PLAYGROUND_ROOT}/Tests/AnimationAnatomyContactTests.cpp")
target_link_libraries(AnimationAnatomyContactTests PRIVATE PlaygroundAnimationImport PlaygroundAnimationPhysics PlaygroundGeometryContacts)
if(TARGET ExperimentRecipe)
    target_include_directories(AnimationAnatomyContactTests PRIVATE "${ENGINE_INPUTS}/Tools/ProceduralAuthoring/Source")
else()
    target_include_directories(AnimationAnatomyContactTests PRIVATE "${JERICO_SOURCE}/Tools/ProceduralAuthoring/Source")
endif()
if(TARGET Jolt)
    target_link_libraries(AnimationAnatomyContactTests PRIVATE Jolt)
else()
    target_include_directories(AnimationAnatomyContactTests PRIVATE "${JERICO_DEPS}/_deps/jolt-src")
    target_compile_definitions(AnimationAnatomyContactTests PRIVATE JPH_CROSS_PLATFORM_DETERMINISTIC)
endif()
add_test(NAME Playground.AnimationAnatomyContacts COMMAND AnimationAnatomyContactTests)
set_tests_properties(Playground.AnimationAnatomyContacts PROPERTIES WORKING_DIRECTORY "${PLAYGROUND_ROOT}")
add_library(PlaygroundAnimationScene STATIC "${PLAYGROUND_ROOT}/Source/AnimationScene.cpp")
target_link_libraries(PlaygroundAnimationScene PUBLIC PlaygroundAnimationImport PlaygroundAnimationPhysics)
target_compile_definitions(PlaygroundAnimationScene PRIVATE PLAYGROUND_ROOT="${PLAYGROUND_ROOT}")
target_link_libraries(${animation_application_target} PRIVATE PlaygroundAnimationScene)
add_executable(AnimationSceneTests "${PLAYGROUND_ROOT}/Tests/AnimationSceneTests.cpp")
target_link_libraries(AnimationSceneTests PRIVATE PlaygroundAnimationScene)
add_test(NAME Playground.AnimationScene COMMAND AnimationSceneTests)
set_tests_properties(Playground.AnimationScene PROPERTIES WORKING_DIRECTORY "${PLAYGROUND_ROOT}")
foreach(component Core Import)
    add_executable(Animation${component}Tests "${PLAYGROUND_ROOT}/Tests/Animation${component}Tests.cpp")
    target_link_libraries(Animation${component}Tests PRIVATE PlaygroundAnimationImport)
    target_compile_definitions(Animation${component}Tests PRIVATE PLAYGROUND_ROOT="${PLAYGROUND_ROOT}")
    add_test(NAME Playground.Animation${component} COMMAND Animation${component}Tests)
    set_tests_properties(Playground.Animation${component} PROPERTIES WORKING_DIRECTORY "${PLAYGROUND_ROOT}")
endforeach()
if(MSVC)
    target_compile_options(JEAnimationToolsCore PRIVATE /W4 /utf-8 /EHsc)
    target_compile_options(PlaygroundAnimationImport PRIVATE /W4 /utf-8 /EHsc)
    target_compile_options(PlaygroundAnimationPhysics PRIVATE /W4 /utf-8 /EHsc)
endif()
